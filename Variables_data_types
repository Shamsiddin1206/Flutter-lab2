import 'dart:math' show sqrt;

String _computeGreeting() {
  print('  (computing the lazy value now...)');
  return 'Hello from a lazy variable!';
}

void problem1() {
  var mutableName = 'Alice';
  final String birthCity = 'Tashkent';
  const double pi = 3.14159;
  late String lazyDescription;

  lazyDescription = 'Initialized later!';
  print('$mutableName born in $birthCity. Math constant: $pi. '
      'Status: $lazyDescription');

  mutableName = 'Alicia';
  print('var was reassigned: $mutableName');

  late final String lazyComputed = _computeGreeting();
  print('Before first access of lazyComputed');
  print(lazyComputed); 
  print(lazyComputed); 
}

void problem2() {
  int age = 20;
